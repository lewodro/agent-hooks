{
  "name": "@agent-hooks/trigger-hooks",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://agenthooks.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewodro/agent-hooks.git",
    "directory": "packages/trigger-hooks"
  },
  "bugs": "https://github.com/lewodro/agent-hooks/issues",
  "description": "Solana event triggers that wake an off-chain Agent Hooks worker.",
  "keywords": ["agents", "automation", "blockchain", "openclaw", "solana", "webhooks"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./openclaw": { "types": "./dist/openclaw.d.ts", "import": "./dist/openclaw.js" },
    "./hermes": { "types": "./dist/hermes.d.ts", "import": "./dist/hermes.js" },
    "./webhook": { "types": "./dist/webhook.d.ts", "import": "./dist/webhook.js" },
    "./launch-proposals": { "types": "./dist/launch-proposals.d.ts", "import": "./dist/launch-proposals.js" },
    "./token-launch": { "types": "./dist/token-launch.d.ts", "import": "./dist/token-launch.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx src/**/*.test.ts",
    "prepack": "pnpm run test && pnpm run build",
    "pack:check": "npm pack --dry-run"
  },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@agent-hooks/contracts": "workspace:*",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "1.95.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
