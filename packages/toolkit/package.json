{
  "name": "@agent-hooks/toolkit",
  "version": "0.1.0",
  "description": "Open-source TypeScript toolkit for Solana hooks, market and social research, agent publishing workflows, and treasury review.",
  "license": "MIT",
  "homepage": "https://agenthooks.io",
  "repository": "https://github.com/lewodro/agent-hooks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "import": "./dist/solana.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./x": {
      "types": "./dist/x.d.ts",
      "import": "./dist/x.js"
    },
    "./treasury": {
      "types": "./dist/treasury.d.ts",
      "import": "./dist/treasury.js"
    },
    "./research": {
      "types": "./dist/market-research.d.ts",
      "import": "./dist/market-research.js"
    },
    "./x-research": {
      "types": "./dist/x-research.d.ts",
      "import": "./dist/x-research.js"
    },
    "./social": {
      "types": "./dist/social.d.ts",
      "import": "./dist/social.js"
    },
    "./moltbook": {
      "types": "./dist/moltbook.d.ts",
      "import": "./dist/moltbook.js"
    }
  },
  "files": [
    "dist/index.js", "dist/index.d.ts",
    "dist/solana.js", "dist/solana.d.ts",
    "dist/agents.js", "dist/agents.d.ts",
    "dist/x.js", "dist/x.d.ts",
    "dist/treasury.js", "dist/treasury.d.ts",
    "dist/market-research.js", "dist/market-research.d.ts",
    "dist/x-research.js", "dist/x-research.d.ts",
    "dist/x-publisher.js", "dist/x-publisher.d.ts",
    "dist/moltbook.js", "dist/moltbook.d.ts",
    "dist/social.js", "dist/social.d.ts",
    "README.md", "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/agents.test.js dist/solana.test.js dist/x.test.js dist/treasury.test.js dist/market-research.test.js dist/x-research.test.js dist/x-publisher.test.js dist/moltbook.test.js",
    "pack:local": "npm run build && npm pack --pack-destination ../../releases"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
